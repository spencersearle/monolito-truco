.DS_Store
__pycache__/

# Claude Code internal state / worktrees
.claude/

# Node / Capacitor
node_modules/
www/

# Capacitor copies the web assets into the native projects on `cap sync`;
# they're regenerated, so they don't need to be tracked.
ios/App/App/public/
android/app/src/main/assets/public/

# Playwright output — traces, screenshots and the HTML report are per-run
test-results/
playwright-report/

# Native build output
*.apk
*.aab
*.ipa

# Signing key material — never commit these. The Android upload keystore is
# irreplaceable: back it up outside the repo (password manager / encrypted drive).
*.jks
*.keystore
*.p12
*.mobileprovision
